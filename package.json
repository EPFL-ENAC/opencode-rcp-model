{
  "name": "opencode-rcp-model",
  "version": "0.3.0",
  "description": "OpenCode TUI plugin for EPFL RCP AIaaS models: sidebar widget + /rcpmodel picker with live status, pool, price, and one-click switch.",
  "type": "module",
  "exports": {
    "./tui": "./tui.tsx"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "rcp",
    "epfl",
    "aiaas",
    "llm"
  ],
  "author": "ENAC-IT4R, EPFL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EPFL-ENAC/opencode-rcp-model.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun build ./tui.tsx --external '@opencode-ai/*' --external '@opentui/*' --external 'solid-js' --external 'solid-js/*' --external 'node:*' --outfile /dev/null"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.3",
    "@opentui/core": "^0.2.2",
    "@opentui/solid": "^0.2.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
