{
  "name": "opencode-rcp-status",
  "version": "1.0.0",
  "description": "OpenCode TUI plugin for EPFL RCP AIaaS models: sidebar widget + /rcpmodel picker with readiness, pool, price, and one-click switch.",
  "type": "module",
  "exports": {
    "./tui": "./tui.tsx"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "rcp",
    "epfl",
    "aiaas",
    "llm"
  ],
  "author": "ENAC-IT4R, EPFL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EPFL-ENAC/opencode-rcp-model.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun build ./tui.tsx --external '@opencode/*' --external '@opentui/*' --external 'solid-js' --external 'solid-js/*' --external 'node:*' --outfile /dev/null"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.3",
    "fuzzysort": "^3.1.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.2.3",
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
